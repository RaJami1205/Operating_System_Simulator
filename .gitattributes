# Normalize text files in the repository
* text=auto

# Source and configuration files
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf

# Maven Wrapper
mvnw text eol=lf
mvnw.cmd text eol=crlf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix shell scripts
*.sh text eol=lf