@startuml
top to bottom direction
skinparam packageStyle rectangle
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 60
skinparam padding 6

title Operating System Simulator - Arquitectura de paquetes
' Raíz común: io.github.rajami1205.osimulator
' Dependencias derivadas de imports internos; tipos anidados se atribuyen a su paquete.
' Vista resumida: omite exception y agrega las relaciones entre capas.

package "Presentation" as pkg_presentation {}
package "Application" as pkg_application {
  package "job" as pkg_application_job {}
  package "lifecycle" as pkg_application_lifecycle {}
  package "process" as pkg_application_process {}
  package "program" as pkg_application_program {}
  package "simulator" as pkg_application_simulator {}
}
package "Infrastructure" as pkg_infrastructure {
  package "asm" as pkg_infrastructure_asm {}
}
package "Model" as pkg_model {
  together {
    package "configuration" as pkg_model_configuration {}
    package "cpu" as pkg_model_cpu {}
    package "execution" as pkg_model_execution {}
    package "filesystem" as pkg_model_filesystem {}
  }
  together {
    package "instruction" as pkg_model_instruction {
      package "operand" as pkg_model_instruction_operand {}
    }
    package "io" as pkg_model_io {}
    package "job" as pkg_model_job {}
    package "memory" as pkg_model_memory {}
  }
  together {
    package "process" as pkg_model_process {}
    package "program" as pkg_model_program {}
    package "scheduling" as pkg_model_scheduling {}
    package "storage" as pkg_model_storage {}
  }
}

pkg_application ..> pkg_model
pkg_infrastructure ..> pkg_application
pkg_infrastructure ..> pkg_model
pkg_presentation ..> pkg_application
pkg_presentation ..> pkg_infrastructure
pkg_presentation ..> pkg_model

' Sólo layout: estos enlaces ocultos no representan dependencias reales.
pkg_model_configuration -[hidden]down-> pkg_model_instruction
pkg_model_instruction -[hidden]down-> pkg_model_process

pkg_application -[hidden]down-> pkg_model

@enduml
