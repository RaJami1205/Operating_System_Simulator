<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1280.0"
            prefHeight="720.0"
            styleClass="app-root"
            stylesheets="@simulator.css">
    <!-- Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="header">
            <VBox spacing="1.0">
                <Label text="Operating System Simulator" styleClass="header-title" />
                <Label text="System Control Dashboard" styleClass="header-subtitle" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox alignment="CENTER_RIGHT" spacing="2.0" styleClass="state-badge">
                <Label text="SIMULATOR STATE" styleClass="state-caption" />
                <Label fx:id="simulatorStateLabel"
                       text="CONFIGURING"
                       styleClass="state-value" />
            </VBox>
        </HBox>
    </top>

    <center>
        <GridPane hgap="10.0" vgap="10.0" styleClass="dashboard-grid">
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
            </padding>
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints percentHeight="67.0" vgrow="ALWAYS" />
                <RowConstraints percentHeight="33.0" vgrow="ALWAYS" />
            </rowConstraints>

            <GridPane hgap="10.0" GridPane.rowIndex="0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="24.0" hgrow="ALWAYS" />
                    <ColumnConstraints percentWidth="46.0" hgrow="ALWAYS" />
                    <ColumnConstraints percentWidth="30.0" hgrow="ALWAYS" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints vgrow="ALWAYS" />
                </rowConstraints>

                <!-- Simulator Control -->
                <VBox spacing="4.0"
                      maxWidth="Infinity"
                      maxHeight="Infinity"
                      styleClass="dashboard-panel"
                      GridPane.columnIndex="0">
                    <Label text="SIMULATOR CONTROL" styleClass="panel-header" />

                    <VBox spacing="4.0" styleClass="control-section" VBox.vgrow="ALWAYS">
                        <Label text="MEMORY CONFIGURATION" styleClass="section-title" />
                        <GridPane hgap="6.0" vgap="4.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="52.0" hgrow="SOMETIMES" />
                                <ColumnConstraints percentWidth="48.0" hgrow="ALWAYS" />
                            </columnConstraints>
                            <Label text="Total Memory Positions"
                                   wrapText="true"
                                   styleClass="section-label"
                                   GridPane.rowIndex="0" />
                            <TextField fx:id="totalMemoryField"
                                       maxWidth="Infinity"
                                       promptText="Enter total positions"
                                       styleClass="input-field"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="0" />
                            <Label text="Kernel Reserved Positions"
                                   wrapText="true"
                                   styleClass="section-label"
                                   GridPane.rowIndex="1" />
                            <TextField fx:id="kernelReservedField"
                                       maxWidth="Infinity"
                                       promptText="Enter kernel positions"
                                       styleClass="input-field"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="1" />
                            <Label text="Minimum: 128 positions"
                                   styleClass="helper-text"
                                   GridPane.columnSpan="2"
                                   GridPane.rowIndex="2" />
                            <Button fx:id="initializeButton"
                                    text="Initialize"
                                    maxWidth="Infinity"
                                    styleClass="primary-button"
                                    GridPane.columnSpan="2"
                                    GridPane.rowIndex="3" />
                        </GridPane>
                    </VBox>

                    <VBox spacing="4.0" styleClass="control-section">
                        <Label text="PROGRAM" styleClass="section-title" />
                        <GridPane hgap="6.0" vgap="4.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="38.0" />
                                <ColumnConstraints percentWidth="62.0" hgrow="ALWAYS" />
                            </columnConstraints>
                            <Label text="Program file (.asm)"
                                   wrapText="true"
                                   styleClass="section-label" />
                            <TextField fx:id="programPathField"
                                       editable="false"
                                       maxWidth="Infinity"
                                       promptText="No program selected"
                                       styleClass="input-field"
                                       GridPane.columnIndex="1" />
                            <Button fx:id="browseProgramButton"
                                    text="Browse"
                                    maxWidth="Infinity"
                                    styleClass="secondary-button"
                                    GridPane.rowIndex="1" />
                            <Button fx:id="loadProgramButton"
                                    text="Load Program"
                                    disable="true"
                                    maxWidth="Infinity"
                                    styleClass="secondary-button"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1" />
                        </GridPane>
                    </VBox>

                    <VBox spacing="4.0" styleClass="control-section">
                        <Label text="EXECUTION" styleClass="section-title" />
                        <GridPane hgap="5.0" vgap="4.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
                                <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
                            </columnConstraints>
                            <Button fx:id="startButton"
                                    text="Start"
                                    disable="true"
                                    maxWidth="Infinity"
                                    styleClass="primary-button" />
                            <Button fx:id="stepButton"
                                    text="Step"
                                    disable="true"
                                    maxWidth="Infinity"
                                    styleClass="secondary-button"
                                    GridPane.columnIndex="1" />
                            <Button fx:id="automaticButton"
                                    text="Automatic"
                                    disable="true"
                                    maxWidth="Infinity"
                                    styleClass="secondary-button"
                                    GridPane.rowIndex="1" />
                            <Button fx:id="pauseButton"
                                    text="Pause"
                                    disable="true"
                                    maxWidth="Infinity"
                                    styleClass="secondary-button"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1" />
                            <Button fx:id="resumeButton"
                                    text="Resume"
                                    disable="true"
                                    maxWidth="Infinity"
                                    styleClass="secondary-button"
                                    GridPane.rowIndex="2" />
                            <Button fx:id="resetButton"
                                    text="Reset"
                                    maxWidth="Infinity"
                                    styleClass="reset-button"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2" />
                        </GridPane>
                    </VBox>
                </VBox>

                <!-- CPU Status and Current Instruction -->
                <VBox spacing="8.0"
                      maxWidth="Infinity"
                      maxHeight="Infinity"
                      GridPane.columnIndex="1">
                    <VBox spacing="6.0" styleClass="dashboard-panel">
                        <Label text="CPU STATUS" styleClass="panel-header" />
                        <GridPane hgap="6.0" vgap="6.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25.0" hgrow="ALWAYS" />
                                <ColumnConstraints percentWidth="25.0" hgrow="ALWAYS" />
                                <ColumnConstraints percentWidth="25.0" hgrow="ALWAYS" />
                                <ColumnConstraints percentWidth="25.0" hgrow="ALWAYS" />
                            </columnConstraints>
                            <VBox spacing="1.0" styleClass="metric-card">
                                <Label text="PC" styleClass="metric-label" />
                                <Label fx:id="pcValueLabel" text="—" styleClass="technical-value" />
                            </VBox>
                            <VBox spacing="1.0"
                                  styleClass="metric-card"
                                  GridPane.columnIndex="1">
                                <Label text="AC" styleClass="metric-label" />
                                <Label fx:id="acValueLabel" text="—" styleClass="technical-value" />
                            </VBox>
                            <VBox spacing="1.0"
                                  styleClass="metric-card"
                                  GridPane.columnIndex="2"
                                  GridPane.columnSpan="2">
                                <Label text="IR" styleClass="metric-label" />
                                <Label fx:id="irValueLabel"
                                       text="—"
                                       maxWidth="Infinity"
                                       wrapText="true"
                                       styleClass="technical-value" />
                            </VBox>
                            <VBox spacing="1.0"
                                  styleClass="metric-card"
                                  GridPane.rowIndex="1">
                                <Label text="AX" styleClass="metric-label" />
                                <Label fx:id="axValueLabel" text="—" styleClass="technical-value" />
                            </VBox>
                            <VBox spacing="1.0"
                                  styleClass="metric-card"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="1">
                                <Label text="BX" styleClass="metric-label" />
                                <Label fx:id="bxValueLabel" text="—" styleClass="technical-value" />
                            </VBox>
                            <VBox spacing="1.0"
                                  styleClass="metric-card"
                                  GridPane.columnIndex="2"
                                  GridPane.rowIndex="1">
                                <Label text="CX" styleClass="metric-label" />
                                <Label fx:id="cxValueLabel" text="—" styleClass="technical-value" />
                            </VBox>
                            <VBox spacing="1.0"
                                  styleClass="metric-card"
                                  GridPane.columnIndex="3"
                                  GridPane.rowIndex="1">
                                <Label text="DX" styleClass="metric-label" />
                                <Label fx:id="dxValueLabel" text="—" styleClass="technical-value" />
                            </VBox>
                        </GridPane>
                    </VBox>

                    <VBox spacing="6.0"
                          maxHeight="Infinity"
                          styleClass="instruction-panel"
                          VBox.vgrow="ALWAYS">
                        <Label text="CURRENT INSTRUCTION" styleClass="panel-header" />
                        <VBox spacing="1.0">
                            <Label text="Semantic Instruction" styleClass="section-label" />
                            <Label fx:id="currentInstructionLabel"
                                   text="—"
                                   maxWidth="Infinity"
                                   wrapText="true"
                                   styleClass="instruction-value" />
                        </VBox>
                        <HBox spacing="6.0">
                            <VBox spacing="1.0" styleClass="instruction-detail" HBox.hgrow="ALWAYS">
                                <Label text="Opcode" styleClass="metric-label" />
                                <Label fx:id="opcodeValueLabel" text="—" styleClass="technical-value" />
                            </VBox>
                            <VBox spacing="1.0" styleClass="instruction-detail" HBox.hgrow="ALWAYS">
                                <Label text="Operand" styleClass="metric-label" />
                                <Label fx:id="operandValueLabel" text="—" styleClass="technical-value" />
                            </VBox>
                        </HBox>
                        <Label text="BINARY FORMAT V1" styleClass="section-title" />
                        <HBox fx:id="binaryWordsContainer" spacing="6.0">
                            <VBox spacing="1.0" styleClass="binary-word" HBox.hgrow="ALWAYS">
                                <Label text="Word 1" styleClass="metric-label" />
                                <Label text="—" styleClass="binary-value" />
                            </VBox>
                            <VBox spacing="1.0" styleClass="binary-word" HBox.hgrow="ALWAYS">
                                <Label text="Word 2 (MOV)" styleClass="metric-label" />
                                <Label text="—" styleClass="binary-value" />
                            </VBox>
                        </HBox>
                        <Label text="Waiting for execution" styleClass="helper-text" />
                    </VBox>
                </VBox>

                <!-- Loaded Program and PCB -->
                <VBox spacing="8.0"
                      maxWidth="Infinity"
                      maxHeight="Infinity"
                      GridPane.columnIndex="2">
                    <VBox spacing="6.0"
                          maxHeight="Infinity"
                          styleClass="dashboard-panel"
                          VBox.vgrow="ALWAYS">
                        <Label text="LOADED PROGRAM" styleClass="panel-header" />
                        <TableView fx:id="programTable"
                                   maxHeight="Infinity"
                                   VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="No program loaded" styleClass="empty-state" />
                            </placeholder>
                            <columns>
                                <TableColumn fx:id="programAddressColumn"
                                             text="Address"
                                             minWidth="64.0"
                                             prefWidth="82.0"
                                             maxWidth="110.0" />
                                <TableColumn fx:id="programInstructionColumn"
                                             text="Instruction"
                                             minWidth="150.0"
                                             prefWidth="230.0" />
                            </columns>
                        </TableView>
                    </VBox>

                    <VBox spacing="5.0" styleClass="dashboard-panel">
                        <Label text="PROCESS CONTROL BLOCK" styleClass="panel-header" />
                        <GridPane hgap="8.0" vgap="3.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="58.0" />
                                <ColumnConstraints percentWidth="42.0" hgrow="ALWAYS" />
                            </columnConstraints>
                            <Label text="PID" styleClass="pcb-label" />
                            <Label fx:id="processIdValueLabel"
                                   text="—"
                                   styleClass="pcb-value"
                                   GridPane.columnIndex="1" />
                            <Label text="PROCESS STATE"
                                   styleClass="pcb-label"
                                   GridPane.rowIndex="1" />
                            <Label fx:id="processStateValueLabel"
                                   text="—"
                                   styleClass="pcb-value"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="1" />
                            <Label text="Start Address"
                                   styleClass="pcb-label"
                                   GridPane.rowIndex="2" />
                            <Label fx:id="processStartValueLabel"
                                   text="—"
                                   styleClass="pcb-value"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="2" />
                            <Label text="Instruction Count"
                                   styleClass="pcb-label"
                                   GridPane.rowIndex="3" />
                            <Label fx:id="processInstructionCountValueLabel"
                                   text="—"
                                   styleClass="pcb-value"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="3" />
                            <Label text="End Exclusive"
                                   styleClass="pcb-label"
                                   GridPane.rowIndex="4" />
                            <Label fx:id="processEndValueLabel"
                                   text="—"
                                   styleClass="pcb-value"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="4" />
                            <Label text="Saved PC"
                                   styleClass="pcb-label"
                                   GridPane.rowIndex="5" />
                            <Label fx:id="processSavedPcValueLabel"
                                   text="—"
                                   styleClass="pcb-value"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="5" />
                        </GridPane>
                    </VBox>
                </VBox>
            </GridPane>

            <!-- Memory View -->
            <VBox spacing="6.0"
                  maxWidth="Infinity"
                  maxHeight="Infinity"
                  styleClass="dashboard-panel"
                  GridPane.rowIndex="1">
                <Label text="MEMORY VIEW" styleClass="panel-header" />
                <TableView fx:id="memoryTable"
                           maxHeight="Infinity"
                           VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="Memory not initialized" styleClass="empty-state" />
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="memoryAddressColumn"
                                     text="Address"
                                     minWidth="72.0"
                                     prefWidth="110.0"
                                     maxWidth="150.0" />
                        <TableColumn fx:id="memoryRegionColumn"
                                     text="Region"
                                     minWidth="90.0"
                                     prefWidth="130.0"
                                     maxWidth="180.0" />
                        <TableColumn fx:id="memoryContentColumn"
                                     text="Content"
                                     minWidth="320.0"
                                     prefWidth="900.0" />
                    </columns>
                </TableView>
            </VBox>
        </GridPane>
    </center>
</BorderPane>
